{
  "schemaVersion": "1.0.0",
  "notation": "UFPN",
  "title": "Ukrainian French Phonetic Notation",
  "status": "EXPERIMENTAL_RESEARCH_SPECIFICATION",
  "unicode": {
    "normalization": "NFC",
    "graphemeAware": true,
    "doNotSplitCombiningSequences": true,
    "unknownIpaPolicy": "preserve as ⟦IPA⟧ and report unsupported"
  },
  "designPrinciples": [
    "IPA is the canonical phonetic input; UFPN never reads French graphemes.",
    "Basic preserves distinctions present in supplied IPA; profile mergers are explicit upstream.",
    "Each custom diacritic has one documented UFPN meaning.",
    "Detailed/Extended distinguish phonological categories from observed phonetic realizations.",
    "Allophone/prosody marks require evidence; spelling/punctuation alone are insufficient.",
    "Never invent speaker-specific realizations."
  ],
  "levels": {
    "basic": {
      "purpose": "Readable practical learning notation",
      "rules": [
        "Ukrainian base graphemes plus UFPN vowel-quality/rounding/nasal markers",
        "Preserve segmental distinctions present in broad IPA",
        "Omit syllable boundaries, stress, length and gradient allophones",
        "Do not merge /œ̃/ with /ɛ̃/ unless selected profile explicitly does so"
      ]
    },
    "detailed": {
      "purpose": "Segment-accurate teaching notation",
      "rules": [
        "All Basic distinctions",
        "Syllable boundary ·",
        "Retain ː and ˑ only when present in IPA",
        "Retain ‿ only when supplied by analysis",
        "Retain narrow modifiers already present in input"
      ]
    },
    "extended": {
      "purpose": "Narrow phonetic and prosodic annotation",
      "rules": [
        "All Detailed distinctions",
        "Pass through standardized IPA modifiers on Ukrainian graphemes",
        "Preserve ˈ/ˌ, ‖ and ↗/↘ only when supplied by audio annotation",
        "Unknown symbols remain visibly bracketed"
      ]
    }
  },
